{
  "name": "@praxis/jira",
  "version": "0.1.0-alpha.43",
  "private": true,
  "type": "module",
  "description": "Praxis Jira Cloud and Data Center orchestration (company infra)",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflows.d.ts",
      "default": "./dist/workflows.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "live-smoke": "node ./tools/live-smoke.mjs",
    "jira-workflow": "node ./tools/jira-workflow.mjs"
  },
  "dependencies": {
    "@praxis/contracts": "*"
  },
  "files": [
    "dist",
    "tools",
    "skills",
    ".claude-plugin",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
