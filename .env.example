# Praxis Phase 1 — configuration template (no secrets).
# Copy to `.env` locally if needed. Never commit real tokens.
# EXTERNAL BLOCKED items (live Jira, domain/TLS, combat CI) stay blocked until ops provides values.

# --- Quality service (apps/quality-service, docker-compose) ---
# SQLite path for CLI/server. Docker compose sets /data/quality.sqlite.
PRAXIS_QUALITY_DB=.praxis-quality/quality.sqlite
# HTTP listen port for quality-service
PORT=8787

# --- Jira Server client (plugins/jira) — required only for live smoke ---
# Leave unset for install/build/verify/smoke (those do not call Jira).
PRAXIS_JIRA_BASE_URL=https://jira.example.com
PRAXIS_JIRA_TOKEN=
PRAXIS_JIRA_PROJECT_KEY=SMOKE
# Optional
# PRAXIS_JIRA_ARCHITECT_ESTIMATE_FIELD=customfield_12345
# PRAXIS_JIRA_SMOKE_FEATURE_KEY=SMOKE-1
