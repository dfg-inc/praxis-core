  "requirements": [
    {
      "id": "REQ-JRN-001",
      "statement": "Лента записей журнала показывается как чат: каждая запись — отдельное сообщение, по времени, старые вверху.",
      "acceptanceCriteria": [
        "Записи идут по времени создания, от старых к новым; новые внизу ленты.",
        "Перед первой записью каждого дня стоит разделитель с датой.",
        "Записи текущего пользователя выровнены справа, записи других участников — слева.",
        "У каждого сообщения видны автор и время; подряд идущие сообщения одного автора группируются, автор показан один раз на группу.",
        "Лента не является таблицей: нет строк и столбцов, каждая запись — отдельный «пузырь» сообщения."
      ]
    },
    {
      "id": "REQ-JRN-002",
      "statement": "Голосовые заметки и вложения видны прямо в сообщении.",
      "acceptanceCriteria": [
        "Голосовое сообщение показывает кнопку воспроизведения и длительность; в прототипе воспроизведение помечено как имитация без звука.",
        "Вложения показаны в сообщении: фото и документы с именем файла и размером.",
        "У голосовой заметки с расшифровкой расшифровка видна под плеером."
      ]
    },
    {
      "id": "REQ-JRN-003",
      "statement": "Шапка журнала, вкладки «Актуальные» и «Архивные», фильтры, поиск и форма новой записи остаются как сейчас; вкладки и фильтры по-прежнему сужают ленту.",
      "acceptanceCriteria": [
        "Шапка журнала и вкладки «Актуальные» и «Архивные» на месте; вкладки переключают ленту между актуальными и архивными записями.",
        "Фильтры «Поле» и «Тип записи» и поиск сужают ленту; выбранные значения сохраняются в адресе.",
        "Если под условия не подходит ни одна запись, лента говорит об этом и предлагает сбросить фильтры.",
        "Форма новой записи (текст, поле, тип, вложение, голосовая заметка, «Добавить запись») остаётся на месте и работает как раньше."
      ]
    },
    {
      "id": "REQ-JRN-004",
      "statement": "Запись открывается в карточке, как и раньше.",
      "acceptanceCriteria": [
        "Нажатие на сообщение открывает карточку записи с полем, типом, автором, временем и вложениями."
      ]
    },
    {
      "id": "REQ-JRN-005",
      "statement": "Журнал работает на телефоне и на компьютере.",
      "acceptanceCriteria": [
        "На ширине телефона сообщения занимают почти всю ширину, лента прокручивается, остальные элементы журнала остаются на месте.",
        "На компьютере сообщение не шире примерно двух третей ленты."
      ]
    }
  ],
