{
  "name": "praxis-core",
  "private": true,
  "version": "0.1.0-alpha.47",
  "description": "Shared Praxis libraries \u2014 contracts, CLI, VCS, Jira, plugin-sdk, knowledge",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "tools/scripts"
  ],
  "scripts": {
    "build": "npm run build -w @praxis/contracts -w @praxis/knowledge -w @praxis/project-config -w @praxis/catalog -w @praxis/testing --if-present && npm run build -w @praxis/plugin-sdk --if-present && npm run build -w @praxis/jira -w @praxis/vcs --if-present && npm run build -w @praxis/cli --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:vendor": "node tools/scripts/pack-core-vendor.mjs",
    "accept:git-delivery-lib": "node tools/scripts/git-delivery-acceptance.mjs",
    "accept:git-delivery-e2e": "node tools/scripts/git-delivery-e2e-acceptance.mjs",
    "verify": "npm run build && npm run typecheck && npm run test && npm run test:security && npm run check:tests",
    "check:version": "node tools/scripts/check-ecosystem-version.mjs",
    "test:security": "node tools/broker/human-approval-denial.test.mjs && node tools/broker/executor-real-mutation.test.mjs && node tools/broker/security-hardening-1-5.test.mjs && node --test tools/broker/webauthn.test.mjs tools/broker/operator-web.test.mjs && npm run test:approval-service",
    "check:tests": "node tools/scripts/check-test-completeness.mjs",
    "test:approval-service": "node --test tools/approval-service/units.test.mjs tools/approval-service/operator-ui.test.mjs tools/approval-service/service.test.mjs tools/approval-service/rollback.test.mjs tools/approval-service/cli.test.mjs tools/approval-service/packaging/artifact.test.mjs tools/approval-service/packaging/macos-installer.test.mjs",
    "accept:approval-service-linux": "node tools/approval-service/acceptance/linux-container.mjs",
    "release:approval-service-macos": "node tools/approval-service/packaging/release-macos.mjs",
    "build:approval-service": "node tools/approval-service/packaging/build.mjs --variant production",
    "pack:approval-service-macos": "node tools/approval-service/packaging/build.mjs --variant production --macos-pkg --node-tarball ../vendor-node/node-v24.22.1-darwin-arm64.tar.gz --node-shasums ../vendor-node/SHASUMS256.txt --node-source-url https://nodejs.org/dist/v24.22.1/node-v24.22.1-darwin-arm64.tar.gz"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfg-inc/praxis-core.git"
  },
  "bugs": {
    "url": "https://github.com/dfg-inc/praxis-core/issues"
  },
  "homepage": "https://github.com/dfg-inc/praxis-core"
}
