  "stories": [
    {
      "id": "US-CFG-001",
      "requirementIds": [
        "REQ-CFG-001"
      ],
      "actor": "Claude Desktop operator",
      "narrative": "As a Claude Desktop operator, I want optional Praxis Runtime settings I left blank to be reported as not configured, so that diagnostics and providers never act on placeholder text.",
      "objective": "Blank optional extension settings are unset",
      "userValue": "Accurate praxis_doctor output and no provider calls with placeholder credentials",
      "preconditions": [
        "Praxis Runtime installed as a Desktop extension with optional GitHub/GitLab settings blank"
      ],
      "happyPath": [
        "Desktop starts the Runtime with PRAXIS_GITLAB_TOKEN='${user_config.gitlab_token}'",
        "Operator calls praxis_doctor",
        "Doctor reports gitlab.tokenConfigured=false and lists the key in hostPlaceholdersIgnored"
      ],
      "alternatives": [
        "A repository .env.praxis supplies a real value for the key; that value is used"
      ],
      "negative": [
        "A value containing '${' inside a longer string is kept unchanged",
        "A non-PRAXIS_ variable holding a placeholder is not modified"
      ],
      "edgeCases": [
        "Placeholder surrounded by whitespace is still treated as unset",
        "PRAXIS_SKIP_DOTENV=1 still scrubs placeholders"
      ],
      "businessRules": [
        "Only whole-value ${...} placeholders on PRAXIS_* keys are removed",
        "Only key names are reported, never values"
      ],
      "acceptanceCriteria": [
        {
          "id": "US-CFG-001-AC-01",
          "given": "PRAXIS_GITLAB_TOKEN and PRAXIS_GITHUB_API_URL hold ${user_config.*} placeholders",
          "when": "placeholders are scrubbed",
          "then": "both keys are removed and only their names are returned"
        },
        {
          "id": "US-CFG-001-AC-02",
          "given": "PRAXIS_NOTE='prefix-${x}' and UNRELATED='${x}'",
          "when": "placeholders are scrubbed",
          "then": "both values are unchanged and nothing is returned"
        }
      ],
      "expectedResults": [
        "praxis_doctor no longer reports blank optional settings as configured or invalid"
      ],
