  "workItem": {
    "id": "WI-TREAT-UNEXPANDED-CLAUDE--001",
    "projectId": "praxis-core",
    "title": "Treat unexpanded Claude Desktop ${user_config.*} placeholders as unset configuration",
    "source": "repository",
    "status": "in_progress",
    "revision": 2
  },
  "requirements": [
    {
      "id": "REQ-CFG-001",
      "statement": "A PRAXIS_* environment value that is exactly an unexpanded host template placeholder (whole value of the form ${...}, e.g. ${user_config.gitlab_token}) must be treated as unset by every Runtime configuration consumer.",
      "revision": 1,
      "status": "proposed",
      "acceptanceCriteria": [
        {
          "id": "REQ-CFG-001-AC-01",
          "requirementId": "REQ-CFG-001",
          "statement": "Given PRAXIS_GITLAB_TOKEN='${user_config.gitlab_token}' and PRAXIS_GITLAB_BASE_URL='${user_config.gitlab_base_url}', praxis_doctor reports gitlab.tokenConfigured=false and baseUrlConfigured=false.",
          "revision": 1
        },
        {
          "id": "REQ-CFG-001-AC-02",
          "requirementId": "REQ-CFG-001",
          "statement": "Given PRAXIS_GITHUB_API_URL='${user_config.github_api_url}', praxis_doctor reports github.apiUrlConfigured=false, apiUrlValid=true and no GITHUB_API_URL_INVALID code.",
          "revision": 1
        },
        {
          "id": "REQ-CFG-001-AC-03",
          "requirementId": "REQ-CFG-001",
          "statement": "Given a placeholder in process env and a real value for the same key in the repository .env.praxis/.env, the repository value is used.",
          "revision": 1
        },
        {
          "id": "REQ-CFG-001-AC-04",
          "requirementId": "REQ-CFG-001",
          "statement": "Real values, including values that merely contain '${' inside a longer string, are not altered.",
          "revision": 1
        },
        {
          "id": "REQ-CFG-001-AC-05",
          "requirementId": "REQ-CFG-001",
          "statement": "Non-PRAXIS_ environment variables are never modified.",
          "revision": 1
        },
        {
          "id": "REQ-CFG-001-AC-06",
          "requirementId": "REQ-CFG-001",
          "statement": "No secret value is logged or returned; only key names may be reported.",
          "revision": 1
        }
      ],
      "serviceIds": [
        "praxis-core-cli"
      ],
      "assumptionIds": []
    }
