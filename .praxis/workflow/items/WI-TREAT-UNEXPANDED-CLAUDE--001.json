  "decisions": [
    {
      "id": "DEC-CFG-001",
      "statement": "Normalize at loadPraxisDotenv in praxis-core/packages/cli/src/operations.ts: before reading dotenv files (and even when PRAXIS_SKIP_DOTENV=1), delete process.env keys matching ^PRAXIS_ whose trimmed value fully matches ^\\$\\{[^}]*\\}$. Export the helper scrubUnexpandedPlaceholders(env) returning removed key names only. doctorOp adds hostPlaceholdersIgnored: string[] (key names, no values). No provider-level changes; providers keep reading process.env. Runtime picks it up via Core vendor rebuild; no manifest change in this item.",
      "confirmed": true,
      "revision": 2
    }
  ],
